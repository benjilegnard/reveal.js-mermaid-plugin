{
  "name": "@benjilegnard/reveal.js-mermaid-plugin",
  "version": "0.3.1",
  "description": "reveal.js plugin rendering mermaid diagrams from code blocks as inline SVG",
  "keywords": [
    "diagram",
    "markdown",
    "mermaid",
    "reveal.js",
    "reveal.js-plugin",
    "slides"
  ],
  "homepage": "https://benjilegnard.github.io/reveal.js-mermaid-plugin/",
  "bugs": "https://github.com/benjilegnard/reveal.js-mermaid-plugin/issues",
  "license": "MIT",
  "author": "Benjamin Legrand",
  "repository": "github:benjilegnard/reveal.js-mermaid-plugin",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "mermaid": "^12.0.0",
    "reveal.js": "^6.0.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "mermaid": ">=10",
    "reveal.js": ">=6"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0"
}
